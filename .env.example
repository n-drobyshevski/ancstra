# ─────────────────────────────────────────────────────────────────────────────
# Ancstra environment variables
#
# Vercel scopes (no custom domain yet — using Vercel-assigned URLs):
#   - Production (branch=main)        → https://ancstra-ndrobyshevskis-projects.vercel.app
#   - Preview, branch=dev              → https://ancstra-git-dev-ndrobyshevskis-projects.vercel.app
#   - Preview, all other branches      → per-commit *.vercel.app URLs (inherit dev where useful)
#
# See docs/architecture/environments.md for the runbook (incl. "Adding a custom
# domain later" if you eventually wire up an apex).
# ─────────────────────────────────────────────────────────────────────────────

# Local SQLite (used when CENTRAL_DATABASE_URL is unset)
DATABASE_URL=./ancstra.db

# Turso central DB (per-environment)
# Production:  libsql://ancstra-central-<org>.turso.io
# Dev:         libsql://ancstra-central-dev-<org>.turso.io
CENTRAL_DATABASE_URL=
TURSO_DATABASE_URL=
# Client (libsql) token for connecting to the DBs above. Per-DB or org-scoped.
TURSO_AUTH_TOKEN=
# Org slug — required by scripts/fork-prod-to-dev.ts to construct dev DB URLs.
TURSO_ORG=
# Platform API token (database:create + tokens:create). Used by the fork
# script — NOT loaded by the runtime app.
TURSO_PLATFORM_TOKEN=

# NextAuth v5 — generate per environment with `openssl rand -base64 32`.
# Never share AUTH_SECRET between prod and dev.
AUTH_SECRET=change-me-to-a-random-secret
# v5 native names (preferred). Legacy NEXTAUTH_URL still works as a fallback.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Deprecated v4 name — kept for backward compat readers; v5 prefers AUTH_URL.
NEXTAUTH_URL=http://localhost:3000

# Public app URL used by sitemap, OAuth redirects, etc.
# Production: https://ancstra-ndrobyshevskis-projects.vercel.app
# Dev:        https://ancstra-git-dev-ndrobyshevskis-projects.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

# OAuth providers (optional — providers without both vars are skipped)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Worker
WORKER_URL=http://localhost:3001

# FamilySearch (REDIRECT_URI differs per env)
FAMILYSEARCH_CLIENT_ID=
FAMILYSEARCH_CLIENT_SECRET=
FAMILYSEARCH_REDIRECT_URI=

# NARA
NARA_API_KEY=

# AI / Anthropic — provision a separate API key for dev so spend is isolated.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=10

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Explicit env tag — production / development. Set per Vercel scope.
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Sampling rate overrides (defaults: 1.0 in NODE_ENV=development, 0.1 in prod)
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
